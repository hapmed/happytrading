generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id             String     @id @default(cuid())
  username       String?    @unique
  email          String     @unique
  passwordHash   String
  name           String?
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  verified       Boolean    @default(false)
  profile        String     @default("balanced")

  // Integración Bitso (claves cifradas AES-256-GCM)
  bitsoApiKey    String?
  bitsoApiSecret String?

  // Preferencias de trading
  tradingEnabled Boolean    @default(true)
  autoTrade      Boolean    @default(true)
  rotate         Boolean    @default(true)
  autoSince      DateTime?
  autoTotalSec   Int        @default(0)
  volatileTop    Int?
  widgetToken    String?
  maxOrderAmount Decimal?   @db.Decimal(18, 8)
  stopLossPct    Decimal?   @db.Decimal(6, 3)
  takeProfitPct  Decimal?   @db.Decimal(6, 3)
  initialCapital Decimal?   @db.Decimal(18, 2)
  riskPct        Decimal?   @db.Decimal(6, 3)
  cashReservePct Decimal?   @db.Decimal(6, 3)
  // Bóveda de ganancias: separa el excedente del capital inicial y no lo reinvierte
  vaultEnabled   Boolean    @default(false)
  vaultAsset     String?    @default("usdc")
  // Retiro de ganancias por SPEI a una CLABE bancaria
  payoutEnabled  Boolean    @default(false)
  payoutClabe    String?
  payoutBeneficiary String?
  workingCapitalMxn Decimal? @db.Decimal(18, 2)
  symbols        String?
  dcaLevels      Int?
  dcaStepPct     Decimal?   @db.Decimal(6, 3)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  trades        Trade[]
  signals       Signal[]
  notifications Notification[]
  snapshots     BalanceSnapshot[]
  portfolio     PortfolioSnapshot[]
  positions     Position[]
  instructions  Instruction[]
  deposits      Deposit[]

  @@index([widgetToken])
  @@map("users")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Trade {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol     String
  side       String // BUY | SELL
  amount     Decimal  @db.Decimal(18, 8)
  price      Decimal  @db.Decimal(18, 8)
  status     String   @default("PENDING") // PENDING | FILLED | CANCELLED | FAILED
  source     String   @default("MANUAL") // MANUAL | AI
  signalId   String?
  pnl        Decimal? @db.Decimal(18, 8)
  reason     String?
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("trades")
}

model Signal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol     String
  action     String // BUY | SELL | HOLD
  confidence Decimal  @db.Decimal(6, 3)
  reasoning  String?
  tokensUsed Int      @default(0)
  latencyMs  Int      @default(0)
  executed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("signals")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  subject   String
  body      String
  status    String    @default("PENDING") // PENDING | SENT | FAILED
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model BalanceSnapshot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency   String
  available  Decimal  @db.Decimal(18, 8)
  locked     Decimal  @db.Decimal(18, 8)
  total      Decimal  @db.Decimal(18, 8)
  capturedAt DateTime @default(now())

  @@index([userId, currency, capturedAt])
  @@map("balance_snapshots")
}

model PortfolioSnapshot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalMxn   Decimal  @db.Decimal(18, 2)
  holdings   Json?
  capturedAt DateTime @default(now())

  @@index([userId, capturedAt])
  @@map("portfolio_snapshots")
}

model Position {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol     String
  baseAmount Decimal  @db.Decimal(18, 8)
  avgCostMxn Decimal  @db.Decimal(18, 8)
  // Niveles por operación propuestos por la IA (opcionales)
  slPriceMxn Decimal? @db.Decimal(18, 8)
  tpPriceMxn Decimal? @db.Decimal(18, 8)
  updatedAt  DateTime @updatedAt

  @@unique([userId, symbol])
  @@map("positions")
}

model Instruction {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  side         String // BUY | SELL
  trigger      String // 'price_below' | 'price_above' | 'immediate'
  triggerPrice Decimal   @db.Decimal(18, 8)
  amountMxn    Decimal?  @db.Decimal(18, 8) // para BUY (gasto en MXN)
  quantity     Decimal?  @db.Decimal(18, 8) // para SELL (cantidad del activo)
  // Niveles por operación propuestos por la IA (opcionales)
  slPriceMxn   Decimal?  @db.Decimal(18, 8)
  tpPriceMxn   Decimal?  @db.Decimal(18, 8)
  reason       String?
  status       String    @default("PENDING") // PENDING | EXECUTED | EXPIRED | CANCELLED
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  executedAt   DateTime?
  tradeId      String?

  @@index([userId, status])
  @@map("instructions")
}

model Deposit {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency   String
  amount     Decimal  @db.Decimal(18, 2)
  kind       String   @default("DEPOSIT") // DEPOSIT | WITHDRAWAL
  note       String?
  detectedAt DateTime @default(now())

  @@index([userId, detectedAt])
  @@map("deposits")
}

model UsageDay {
  id       String @id @default(cuid())
  day      String
  provider String
  requests Int    @default(0)
  tokens   Int    @default(0)
  errors   Int    @default(0)

  @@unique([day, provider])
  @@map("usage_days")
}
